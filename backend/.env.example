# V2 EveryGPT Chat Completions (Gemini via OpenAI-compatible proxy)
# Fill EVERYGPT_API_KEY with a rotated secret in a local .env only.
# Never commit real keys. Keys exposed in chat must be revoked.

GAL_LLM_PROVIDER=everygpt
EVERYGPT_API_KEY=
EVERYGPT_BASE_URL=https://api.everygpt.site/v1
GAL_LLM_MODEL=gemini-3.7-flash
GAL_LLM_API=chat_completions
GAL_LLM_TIMEOUT_SECONDS=180  # hard per-call deadline; 0 = disabled. A hung provider fails the turn fast
GAL_LLM_MAX_RETRIES=1

# Alternative provider: OpenCode Go Responses (DeepSeek)
# GAL_LLM_PROVIDER=opencode_go
# OPENCODE_GO_API_KEY=
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# GAL_LLM_MODEL=deepseek-v4-flash
# GAL_LLM_API=responses

# Optional process paths (API)
# GAL_DATABASE_PATH=data/story-v2.db
# GAL_SCRIPT_PACK_ROOT=script_packs

# Playthrough transcripts (author/dev-side, incremental markdown)
# GAL_PLAYTHROUGH_ROOT=data/playthroughs
